{
  "name": "staleguard",
  "version": "1.0.0",
  "private": true,
  "description": "Alert when scheduled jobs stop succeeding, by checking how fresh their last success is instead of trusting exit codes.",
  "license": "MIT",
  "author": "NEXTRIQ",
  "repository": {
    "type": "git",
    "url": "https://github.com/NEXTRIQ/staleguard.git"
  },
  "keywords": [
    "monitoring",
    "cron",
    "systemd",
    "heartbeat",
    "alerting",
    "freshness"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "staleguard": "dist/bin/staleguard.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run clean && tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "start": "node dist/bin/staleguard.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0"
  }
}
