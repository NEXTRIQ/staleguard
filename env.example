# /etc/staleguard/env  (root:root, mode 600). Secrets only; checks live in staleguard.json.
# Configure at least one alert channel.
STALEGUARD_TELEGRAM_BOT_TOKEN=
STALEGUARD_TELEGRAM_CHAT_ID=
# Generic JSON webhook (Slack/Discord bridges, ntfy, your own endpoint). Must be https.
STALEGUARD_WEBHOOK_URL=
# Optional dead man's switch for staleguard itself (e.g. a healthchecks.io ping URL).
STALEGUARD_HEARTBEAT_URL=
# STALEGUARD_STATE_FILE=/var/lib/staleguard/state.json
